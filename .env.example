# Copy to .env and change the values:   cp .env.example .env
# All compose files read these. Placeholders only, never commit real secrets.

# Password of the built-in `elastic` superuser (Elasticsearch, Logstash, Fluentd, Vector use it)
ELASTIC_PASSWORD=changeme-elastic
# Password the setup container assigns to the built-in `kibana_system` user (Kibana uses it)
KIBANA_PASSWORD=changeme-kibana
# Fluent Bit -> Fluentd forward authentication
FLUENT_SHARED_KEY=changeme-shared-key
# Grafana admin password (only with --profile metrics)
GRAFANA_PASSWORD=changeme-grafana
# Optional S3 archive for Fluentd/Vector (leave empty to run without archival)
S3_BUCKET=my-logs-archive
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ENVIRONMENT=lab
DATACENTER=dc1
